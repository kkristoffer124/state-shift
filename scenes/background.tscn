[gd_scene format=3]

[sub_resource type="Shader" id="Shader_bg"]
code = "shader_type canvas_item;

uniform vec4 top_color : source_color = vec4(0.05, 0.08, 0.15, 1.0);
uniform vec4 bottom_color : source_color = vec4(0.07, 0.19, 0.25, 1.0);
uniform float bubble_strength = 0.07;

void fragment() {
	vec2 uv = SCREEN_UV;
	vec3 c = mix(top_color.rgb, bottom_color.rgb, uv.y);
	float aspect = SCREEN_PIXEL_SIZE.y / SCREEN_PIXEL_SIZE.x;
	float b = 0.0;
	for (int i = 0; i < 14; i++) {
		float fi = float(i);
		float speed = 0.015 + 0.03 * fract(fi * 0.37);
		vec2 p = vec2(fract(sin(fi * 12.9898) * 43758.5453), fract(1.0 - TIME * speed - fi * 0.173));
		p.x += sin(TIME * 0.5 + fi) * 0.01;
		float r = 0.008 + 0.02 * fract(fi * 0.618);
		vec2 d = (uv - p) * vec2(aspect, 1.0);
		b += smoothstep(r, r * 0.2, length(d)) * bubble_strength;
	}
	COLOR = vec4(c + vec3(b * 0.8, b, b), 1.0);
}
"

[sub_resource type="ShaderMaterial" id="Mat_bg"]
shader = SubResource("Shader_bg")

[node name="Background" type="CanvasLayer"]
layer = -100

[node name="ColorRect" type="ColorRect" parent="."]
material = SubResource("Mat_bg")
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2
