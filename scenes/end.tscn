[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/menu.gd" id="1"]
[ext_resource type="PackedScene" path="res://scenes/background.tscn" id="bg"]
[ext_resource type="Texture2D" path="res://assets/ui/u1_logo.png" id="logo"]

[node name="End" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")
is_end_screen = true

[node name="Background" parent="." instance=ExtResource("bg")]

[node name="Center" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -300.0
offset_top = -150.0
offset_right = 300.0
offset_bottom = 150.0
grow_horizontal = 2
grow_vertical = 2
alignment = 1
theme_override_constants/separation = 16

[node name="Logo" type="TextureRect" parent="Center"]
texture_filter = 1
custom_minimum_size = Vector2(300, 75)
layout_mode = 2
texture = ExtResource("logo")
expand_mode = 1
stretch_mode = 5

[node name="Title" type="Label" parent="Center"]
layout_mode = 2
theme_override_colors/font_color = Color(0.7, 1, 0.8, 1)
theme_override_font_sizes/font_size = 56
text = "YOU ESCAPED!"
horizontal_alignment = 1

[node name="Stats" type="Label" parent="Center"]
layout_mode = 2
theme_override_font_sizes/font_size = 22
text = "Time 0:00      Puddles lost 0"
horizontal_alignment = 1

[node name="Again" type="Label" parent="Center"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 0.6)
theme_override_font_sizes/font_size = 18
text = "SPACE play again  ·  ESC menu"
horizontal_alignment = 1
