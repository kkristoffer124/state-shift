[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/menu.gd" id="1"]
[ext_resource type="PackedScene" path="res://scenes/background.tscn" id="bg"]
[ext_resource type="PackedScene" path="res://scenes/player.tscn" id="player"]
[ext_resource type="Texture2D" path="res://assets/ui/u1_logo.png" id="logo"]

[node name="Menu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
script = ExtResource("1")

[node name="Background" parent="." instance=ExtResource("bg")]

[node name="Center" type="VBoxContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -300.0
offset_top = -250.0
offset_right = 300.0
offset_bottom = 250.0
grow_horizontal = 2
grow_vertical = 2
theme_override_constants/separation = 14

[node name="Title" type="TextureRect" parent="Center"]
texture_filter = 1
custom_minimum_size = Vector2(600, 150)
layout_mode = 2
texture = ExtResource("logo")
expand_mode = 1
stretch_mode = 5

[node name="Subtitle" type="Label" parent="Center"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.93, 1, 0.75)
theme_override_font_sizes/font_size = 20
text = "Freeze. Melt. Evaporate. Escape."
horizontal_alignment = 1

[node name="Spacer" type="Control" parent="Center"]
custom_minimum_size = Vector2(0, 136)
layout_mode = 2

[node name="Start" type="Label" parent="Center"]
layout_mode = 2
theme_override_font_sizes/font_size = 24
text = "Press SPACE to start"
horizontal_alignment = 1

[node name="Controls" type="Label" parent="Center"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 1, 1, 0.5)
theme_override_font_sizes/font_size = 15
text = "A/D move · SPACE jump · E/SHIFT heat · Q/CTRL cool · R restart"
horizontal_alignment = 1

[node name="Blobs" type="Node2D" parent="."]
position = Vector2(480, 300)

[node name="Ice" parent="Blobs" instance=ExtResource("player")]
position = Vector2(-90, 0)
scale = Vector2(2, 2)
state = 0
demo = true

[node name="Water" parent="Blobs" instance=ExtResource("player")]
scale = Vector2(2, 2)
demo = true

[node name="Steam" parent="Blobs" instance=ExtResource("player")]
position = Vector2(90, 0)
scale = Vector2(2, 2)
state = 2
demo = true
