; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="State Shift"
run/main_scene="res://scenes/menu.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icon.svg"

[autoload]

Save="*res://scripts/save.gd"
Settings="*res://scripts/settings.gd"
Sfx="*res://scripts/sfx.gd"
Game="*res://scripts/game.gd"
Hud="*res://scenes/hud.tscn"
Overlay="*res://scenes/ui/overlay.tscn"
UiFx="*res://scripts/ui/ui_fx.gd"
SettingsFx="*res://scenes/settings_fx.tscn"

[audio]

buses/default_bus_layout="res://default_bus_layout.tres"

[display]

window/size/viewport_width=960
window/size/viewport_height=540
window/size/mode=2
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/custom_font="res://assets/fonts/pixelify.tres"

